# MongoDB Atlas (free M0 cluster) — Atlas dashboard → Connect → Drivers
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hpb?retryWrites=true&w=majority"
MONGODB_DB="hpb"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-32-byte-secret"

# Frontend origin(s) allowed through CORS (comma-separated)
FRONTEND_URL="http://localhost:3000,https://<your-frontend>.vercel.app"
